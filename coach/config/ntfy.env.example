# ntfy push notification config.
# Copy to ntfy.env and fill in your values.
#
# Option A: Self-host ntfy on this Mac mini (most private, free)
#   brew install ntfy
#   ntfy serve --listen-http :2586
#   NTFY_URL=http://localhost:2586/coach
#
# Option B: Use free public ntfy.sh server
#   Pick a hard-to-guess topic name (acts as your private channel)
#   NTFY_URL=https://ntfy.sh/your-secret-topic-abc123
#
# Then subscribe to the topic in the ntfy iOS app.
NTFY_URL=https://ntfy.sh/your-secret-topic-name
